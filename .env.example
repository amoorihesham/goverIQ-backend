# ── Environment & Server ──────────────────────────────────────────────────────
# Required: runtime environment — one of development | production | test
NODE_ENV=development

# Required: HTTP port the server listens on
PORT=3000

# Required: host to bind (use 0.0.0.0 in Docker)
HOST=127.0.0.1

# Required: log level — one of debug | info | warn | error | fatal
LOG_LEVEL=debug

# Required: public base URL for OpenAPI servers[] entry
APP_BASE_URL=http://localhost:3000

# Required: Strict-Transport-Security max-age in seconds (only active in production)
HELMET_HSTS_MAX_AGE=31536000

# Required: maximum request body size in bytes
MAX_BODY_LIMIT=65536

# ── Database ──────────────────────────────────────────────────────────────────
# Required: PostgreSQL connection URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/groven_iq

# Required: maximum number of connections in the pool
DATABASE_POOL_MAX_SIZE=10

# Default 200: slow-query log threshold in milliseconds
DB_SLOW_QUERY_THRESHOLD_MS=200

# ── Redis & Queue ─────────────────────────────────────────────────────────────
# Required: Redis connection URL for the background job queue
REDIS_URL=redis://localhost:6379

# Default redis: queue backend implementation
QUEUE_BACKEND=redis

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# Required (min 32 chars): secret for signing access tokens
JWT_ACCESS_SECRET=replace-with-a-random-secret-that-is-at-least-32-chars

# Required (min 32 chars): secret for signing refresh tokens
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-chars

# ── SMTP (Email) ──────────────────────────────────────────────────────────────
# Required: SMTP server hostname
SMTP_HOST=localhost

# Default 587: SMTP port
SMTP_PORT=1025

# Optional: SMTP authentication username
SMTP_USER=

# Optional: SMTP authentication password
SMTP_PASSWORD=

# Required: sender address for outgoing email
SMTP_FROM=noreply@groven.local

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
# Required: OTLP exporter endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Default grove-iq: service name reported in traces
OTEL_SERVICE_NAME=grove-iq

# Default 1.0.0: service version reported in traces
OTEL_SERVICE_VERSION=1.0.0

# ── Sentry ────────────────────────────────────────────────────────────────────
# Optional: Sentry DSN (omit to disable error reporting)
SENTRY_DSN=

# Optional: environment tag sent to Sentry
SENTRY_ENVIRONMENT=

# Optional: release version tag sent to Sentry
SENTRY_RELEASE=
