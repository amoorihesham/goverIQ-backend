# ENVIRONMENT AND SERVER
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=debug
MAX_BODY_LIMIT=65536
APP_BASE_URL=http://localhost:3000,

# DATABASE
DATABASE_URL=....
DATABASE_POOL_MAX_SIZE=10


REDIS_URL=redis://localhost:6379
QUEUE_BACKEND=redis
  


# SMTP (EMAIL)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@groven.local

# AUTH MODULE OPTIONS
PASSWORD_SALT_ROUNDS=10
OTP_LENGTH=6
OTP_TTL_MS=600000
OTP_RESEND_COOLDOWN_SEC=60
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=refresh_token

JWT_SECRET=dev-jwt-secret-must-be-at-least-32-characters-long-xxxxx
COOKIE_SECRET=dev-cookie-secret-must-be-at-least-32-characters-long-xxxx
