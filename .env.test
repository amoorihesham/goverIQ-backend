# ENVIRONMENT 
NODE_ENV=test
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info


# SERVER
APP_BASE_URL=http://localhost:3000
HELMET_HSTS_MAX_AGE=63072000
MAX_BODY_LIMIT=65536

# DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/groven_iq_test
DATABASE_POOL_MAX_SIZE=10

# REDIS & QUEUE
REDIS_URL=redis://localhost:6379
QUEUE_BACKEND=redis
  


# SMTP (EMAIL)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@groven.local

# JWT CONFIG
JWT_ACCESS_SECRET=dev-jwt-secret-must-be-at-least-32-characters-long-xxxxx
JWT_REFRESH_SECRET=dev-jwt-secret-must-be-at-least-32-characters-long-xxxxx

# OTEL CONFIG
OTEL_SERVICE_NAME=groven-iq
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

 
