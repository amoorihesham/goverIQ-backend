    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.5"
