{
  "name": "groven-iq",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --import ./src/tracing.ts ./src/main.ts",
    "build": "tsup",
    "type-check": "tsc",
    "start": "cross-env NODE_ENV=production node --import ./dist/tracing.js ./dist/main.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier -c .",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/shared/database/migrate.ts",
    "gen:openapi": "cross-env NODE_ENV=development tsx scripts/gen-openapi.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/otel": "^0.18.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/type-provider-zod": "^1.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/exporter-prometheus": "^0.217.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@sentry/node": "^10.53.1",
    "@sentry/opentelemetry": "10.53.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.6",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.8.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.7",
    "pdfkit": "0.15.2",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ulid": "^3.0.2",
    "zod": "~4.4.1"
